{
  "name": "medexplain-ai",
  "version": "1.0.0",
  "description": "AI-powered healthcare assistance platform",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && ..\\.venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8000",
    "frontend": "cd frontend && npm start",
    "install-all": "cd backend && pip install -r requirements.txt && cd ../frontend && npm install",
    "build": "cd frontend && npm run build"
  },
  "keywords": ["healthcare", "AI", "medical", "reports"],
  "author": "MedExplain AI Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^7.6.0"
  }
}